{
  "name": "drag-for-the-crown",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tools/e2e-historia.mjs http://localhost:4173/",
    "lint": "eslint . && node tools/lint-historia.mjs",
    "format": "prettier --write src tests",
    "e2e:mp": "node tools/e2e-mp.mjs http://localhost:4173/",
    "e2e:smoke": "node tools/smoke-test.mjs http://localhost:4173/",
    "e2e:moneda": "SEASON=5 node tools/e2e-historia.mjs http://localhost:4173/",
    "e2e:next": "node tools/e2e-next.mjs http://localhost:4173/",
    "e2e:mp-nueva": "node tools/e2e-mp-nueva.mjs http://localhost:4173/",
    "e2e:grupos": "node tools/e2e-grupos.mjs http://localhost:4173/",
    "e2e:historia-nueva": "node tools/e2e-historia-nueva.mjs http://localhost:4173/",
    "e2e:jurado": "JURADO=1 node tools/e2e-historia.mjs http://localhost:4173/",
    "server": "npm run build --prefix server && node server/dist/index.js",
    "e2e:mp-server": "node tools/e2e-mp-server.mjs ws://localhost:2599 && node tools/e2e-mp-online.mjs http://localhost:4173/ ws://localhost:2599",
    "start": "node server/dist/index.js",
    "build:server": "npm ci --prefix server && npm run build --prefix server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.9",
    "@supabase/supabase-js": "^2.118.0",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xstate": "^5.33.3",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
